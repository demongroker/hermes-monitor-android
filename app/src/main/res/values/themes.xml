<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always-dark navy theme; navy window background prevents any white flash. -->
    <style name="Theme.HermesMonitor" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextColor">@color/text_primary</item>
    </style>
</resources>
